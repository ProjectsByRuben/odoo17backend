<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- vista form library.book -->
        <record id="library_book_view_form" model="ir.ui.view">
            <field name="name">library_book.view.form</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <form string="Book Form">
                    <header>
                        <field name="stage_id" widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar" nolabel="1"/>
                        <group col="4">
                            <group colspan="2">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="price"/>
                            </group>
                            <group>
                                <field name="isbn"/>
                                <field name="pages"/>
                                <field name="author_id"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Book Details" colspan="4">
                                <group>
                                    <field name="description" nolabel="1" colspan="2" placeholder="Description"/>
                                    <field name="comments" nolabel="1" colspan="2" placeholder="Comments"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- vista tree library.book -->
        <record id="library_book_view_tree" model="ir.ui.view">
            <field name="name">library_book.view.tree</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <tree string="Book tree">
                    <field name="id" optional="hide"/>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="author_id"/>
                </tree>
            </field>
        </record>

        <!-- kanban view -->
        <record id="library_book_kanban_view" model="ir.ui.view">
            <field name="name">library.book.kanban.view</field>
            <field name="model">library.book</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" default_group_by="stage_id" on_create="quick_create"
                        archivable="false" sample="1">
                    <field name="pages"/>
                    <field name="author_id"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="row">
                                        <div class="col-8">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div class="col-4">
                                            <field name="image" widget="image" class="oe_avatar"
                                                   options='{"size": [60, 60]}'/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-8 fw-bolder" t-if="record.author_id.raw_value">
                                            <span>Author:</span>
                                            <span t-out="record.author_id.value" class="fw-bolder"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-5 text-left">
                                            <span>Pages</span>
                                            <span class="badge rounded-pill bg-success text-white">
                                                <t t-out="record.pages.value"/>
                                            </span>
                                        </div>

                                        <div class="col-7 text-end">
                                            <field name="price" widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </div>
                                    </div>
                                    <!--<div t-if="record.pages.value &gt; 0" class="row">
                                        <p>Soy un texto condicional</p>
                                    </div>-->
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- action view -->
        <record id="action_library_book" model="ir.actions.act_window">
            <field name="name">Library Book</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_group_by_stage_id': True, 'search_default_filter_active': True}</field>
        </record>
    </data>
</odoo>
