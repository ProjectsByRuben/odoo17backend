<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- vista form library.book -->
        <record id="library_book_view_form" model="ir.ui.view">
            <field name="name">library_book.view.form</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <form string="Book Form">
                    <header>
                        <field name="stage_id" widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="pages"/>
                            <field name="author_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- vista tree library.book -->
        <record id="library_book_view_tree" model="ir.ui.view">
            <field name="name">library_book.view.tree</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <tree string="Book tree">
                    <field name="id" optional="hide"/>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="author_id"/>
                </tree>
            </field>
        </record>

        <!-- kanban view -->
        <record id="library_book_kanban_view" model="ir.ui.view">
            <field name="name">library.book.kanban.view</field>
            <field name="model">library.book</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" default_group_by="stage_id" on_create="quick_create"
                        archivable="false" sample="1">
                    <field name="pages"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-lg-8">
                                                <div class="oe_kanban_details">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </strong>
                                                    <br/>
                                                    <strong class="o_kanban_record_date">
                                                        <field name="date"/>
                                                    </strong>
                                                </div>
                                            </div>
                                            <div class="col-lg-4">
                                                <field name="image" widget="image" class="oe_avatar"
                                                       options='{"size": [50, 50]}'/>
                                            </div>
                                        </div>
                                        <div t-if="record.pages.value &gt; 0" class="row">
                                            <p>Soy un texto condicional</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- action view -->
        <record id="action_library_book" model="ir.actions.act_window">
            <field name="name">Library Book</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
