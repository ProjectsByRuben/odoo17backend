<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_sale_2">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Date Order</th>
                                    <th>Customer</th>
                                    <th class="text-end">Nro.Products</th>
                                    <th class="text-end">Tot. Paid</th>
                                    <th class="text-end">Sub Total</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Total Order</th>
                                    <th class="text-end">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="docs" t-as="doc" t-key="doc.id">
                                    <t t-set="doc"
                                        t-value="doc.with_context(lang=user.partner_id.lang)" />
                                    <td>
                                        <span t-field="doc.name" />
                                    </td>
                                    <td>
                                        <span t-field="doc.date_order"
                                            t-options="{'widget': 'date'}" />
                                    </td>
                                    <td>
                                        <span t-field="doc.partner_id" />
                                    </td>
                                    <td class="text-end">
                                        <!-- articulos  -->
                                        <!-- <span t-out="sum(l.product_uom_qty for l in
                                        doc.order_line)"/> -->
                                        <span t-out="int(doc.tot_articulos)" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="doc.amount_paid" />
                                    </td>
                                    <td class="text-right text-end">
                                        <strong>
                                            <span t-field="doc.amount_untaxed" />
                                        </strong>
                                    </td>
                                    <td class="text-right text-end">
                                        <strong>
                                            <span t-field="doc.amount_tax" />
                                        </strong>
                                    </td>
                                    <td class="text-right text-end">
                                        <strong>
                                            <span t-field="doc.amount_total" />
                                        </strong>
                                    </td>
                                    <td>
                                        <t t-if="doc.state == 'draft'">
                                            <span t-out="'Quotation'" />
                                        </t>
                                        <t t-if="doc.state == 'sale'">
                                            <span t-out="'Order'" />
                                        </t>
                                        <t t-if="doc.state == 'sent'">
                                            <span t-out="'Sent'" />
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
                <!-- <t t-call="sale_custom_report.report_saleorder_document"
                t-lang="doc.partner_id.lang" /> -->
            </t>
        </template>

        <!-- Translatable template -->
